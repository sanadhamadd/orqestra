# Files the README's examples write in the working tree
/tasks.json
/echo-tasks.json

# Each child's stdout and stderr from a live benchmark campaign, written beside the committed results
benchmarks/results/campaigns/*/logs/

# Python bytecode
__pycache__/
*.py[cod]

# Builds: the wheel and sdist, make package-check, and the benchmarks' raw files (build/bench)
build/
dist/
*.egg-info/

# The virtualenv, tool caches and coverage output
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local environment files; the example stays tracked
.env
.env.*
!.env.example
.envrc
