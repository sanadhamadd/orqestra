# Copy to .env for local development. Never commit .env.
# Commands that load settings read .env from the current directory in every
# environment, production included; a variable set in the environment wins over the file.
# The settings in this first block are optional; defaults are shown.

ORQESTRA_ENVIRONMENT=development        # development | test | production
ORQESTRA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ORQESTRA_WORKER_CONCURRENCY=4           # validated (1-256) but unused: the worker is single-slot (DEC-054)
# PostgreSQL DSN used by `orqestra migrate`, `orqestra worker run` and the `orqestra job`
# commands. Treated as a secret. This is the Docker Compose database (docs/development.md).
# ORQESTRA_DATABASE_URL=postgresql://orqestra_local@127.0.0.1:5433/orqestra_local
# OpenRouter API key (DEC-060). Optional and treated as a secret. Read only by the
# benchmark worker's live mode (`--provider openrouter --allow-live-calls`, DEC-071), from
# the process environment, never by the packaged commands; a dry run never reads it.
# `orqestra health` shows it as ***.
# ORQESTRA_OPENROUTER_API_KEY=

# Worker runtime settings (WorkerSettings, DEC-044). All are required by the
# worker and have no defaults: operational values are not decided yet. Durations
# are ISO 8601 (PT30S) or HH:MM:SS; a bare number has no unit and is refused.
# ORQESTRA_WORKER_LEASE=
# ORQESTRA_WORKER_EXECUTION_TIMEOUT=
# ORQESTRA_WORKER_HEARTBEAT_INTERVAL=
# ORQESTRA_WORKER_DB_OPERATION_TIMEOUT=
# ORQESTRA_WORKER_LOCK_TIMEOUT=          # >= 1 ms and, in whole ms, < DB_OPERATION_TIMEOUT
# ORQESTRA_WORKER_FENCE_MARGIN=
# ORQESTRA_WORKER_POLL_INTERVAL=
# ORQESTRA_WORKER_RECOVERY_INTERVAL=
# ORQESTRA_WORKER_RECOVERY_BATCH_LIMIT=
# ORQESTRA_WORKER_SHUTDOWN_TIMEOUT=
# Retry backoff (DEC-053): base <= max, and every worker must use the same two
# values (nothing checks this). Illustrative only, not recommendations:
# ORQESTRA_WORKER_RETRY_BASE_DELAY=      # e.g. PT1S: the wait after the first ended attempt
# ORQESTRA_WORKER_RETRY_MAX_DELAY=       # e.g. PT5M: the cap on any one wait

# Benchmarks only: the dedicated local database of the harness in benchmarks/.
# Its name must be orqestra_bench and its host local; the harness refuses anything
# else (README, "Running the benchmarks").
# ORQESTRA_BENCH_DATABASE_URL=postgresql:///orqestra_bench

# Test-only: the dedicated local database for `make verify`. Its name must be
# orqestra_test and its host local; integration tests refuse anything else.
# Read by the test suite only, never by the application.
# ORQESTRA_TEST_DATABASE_URL=postgresql:///orqestra_test
# Both URLs above are read from the process environment only, never from .env.
