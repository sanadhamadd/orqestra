# Copy to .env for local development. Never commit .env.
# All settings are optional on Day 1; defaults are shown.

ORQESTRA_ENVIRONMENT=development        # development | test | production
ORQESTRA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ORQESTRA_WORKER_CONCURRENCY=4           # concurrent task slots per worker process (1-256)
# PostgreSQL DSN used by `orqestra migrate`. Treated as a secret.
# ORQESTRA_DATABASE_URL=postgresql://orqestra:orqestra@localhost:5432/orqestra

# Test-only: the dedicated local database for `make verify`. Its name must be
# orqestra_test and its host local; integration tests refuse anything else.
# Read by the test suite only, never by the application.
# ORQESTRA_TEST_DATABASE_URL=postgresql:///orqestra_test
