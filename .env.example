# Copy to .env for local development. Never commit .env.
# All settings are optional on Day 1; defaults are shown.

ORQESTRA_ENVIRONMENT=development        # development | test | production
ORQESTRA_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
ORQESTRA_WORKER_CONCURRENCY=4           # validated (1-256) but not read yet: the worker is single-slot
# PostgreSQL DSN used by `orqestra migrate` and `orqestra worker run`. Treated as a secret.
# ORQESTRA_DATABASE_URL=postgresql://orqestra:orqestra@localhost:5432/orqestra

# Worker runtime settings (WorkerSettings, DEC-044). All are required by the
# worker and have no defaults: operational values are not decided yet. Durations
# are ISO 8601 (PT30S) or HH:MM:SS; a bare number has no unit and is refused.
# ORQESTRA_WORKER_LEASE=
# ORQESTRA_WORKER_EXECUTION_TIMEOUT=
# ORQESTRA_WORKER_HEARTBEAT_INTERVAL=
# ORQESTRA_WORKER_DB_OPERATION_TIMEOUT=
# ORQESTRA_WORKER_LOCK_TIMEOUT=          # >= 1 ms and, in whole ms, < DB_OPERATION_TIMEOUT
# ORQESTRA_WORKER_FENCE_MARGIN=
# ORQESTRA_WORKER_POLL_INTERVAL=
# ORQESTRA_WORKER_RECOVERY_INTERVAL=
# ORQESTRA_WORKER_RECOVERY_BATCH_LIMIT=
# ORQESTRA_WORKER_SHUTDOWN_TIMEOUT=
# Retry backoff (DEC-053): base <= max, and every worker must use the same two
# values (nothing checks this). Illustrative only, not recommendations:
# ORQESTRA_WORKER_RETRY_BASE_DELAY=      # e.g. PT1S: the wait after the first ended attempt
# ORQESTRA_WORKER_RETRY_MAX_DELAY=       # e.g. PT5M: the cap on any one wait

# Test-only: the dedicated local database for `make verify`. Its name must be
# orqestra_test and its host local; integration tests refuse anything else.
# Read by the test suite only, never by the application.
# ORQESTRA_TEST_DATABASE_URL=postgresql:///orqestra_test
